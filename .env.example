# --- Database ---
# Leave DATABASE_URL unset to use embedded PGlite (data in ./.pglite). Set it to use a real Postgres.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/labordispatch

# --- API server ---
PORT=3000
HOST=0.0.0.0
# Shared secret for internal admin/API routes (Bearer token). Generate with: openssl rand -hex 32
API_TOKEN=change-me

# --- Claude (intake agent) ---
# Resolved by the Anthropic SDK: ANTHROPIC_API_KEY, or an `ant auth login` profile.
# ANTHROPIC_API_KEY=sk-ant-...
INTAKE_MODEL=claude-opus-5-5

# --- Chatwoot (SMS + web chat) ---
CHATWOOT_BASE_URL=https://app.chatwoot.com
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_API_TOKEN=
# Random string you also put in the Chatwoot webhook URL as ?token=... so we can verify the sender.
CHATWOOT_WEBHOOK_TOKEN=change-me

# --- Identity verification ---
# Days since last verification during which a contact method is treated as trusted.
VERIFICATION_TRUST_DAYS=90
# Minutes a scheduling hold is kept before it expires.
APPOINTMENT_HOLD_MINUTES=15
# Minutes a dispatch offer stays open before moving to the next provider.
DISPATCH_OFFER_MINUTES=20

# --- DEMO ONLY (remove before production) ---
# Enables /demo/* routes, fake problem generator, and fake dispatch receivers.
DEMO_MODE=true
DEMO_RECEIVERS_PORT=3100
